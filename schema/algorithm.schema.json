{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qubitera.dev/schema/algorithm.schema.json",
  "title": "QuAlgLib Algorithm Metadata",
  "type": "object",
  "required": [
    "id", "name", "category", "problem_class", "problem_tags",
    "quantum_complexity", "speedup", "maturity", "source", "last_reviewed"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "category": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "problem_class": { "type": "string" },
    "problem_tags": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "classical_complexity": { "type": "string" },
    "quantum_complexity": { "type": "string" },
    "speedup": {
      "type": "string",
      "enum": ["exponential", "superpolynomial", "polynomial", "quadratic", "heuristic", "none-proven"]
    },
    "qubits_required": { "type": "string" },
    "circuit_depth": { "type": "string" },
    "requires_fault_tolerance": { "type": "boolean" },
    "hardware_assumptions": { "type": "string" },
    "maturity": {
      "type": "string",
      "enum": ["textbook", "demonstrated", "research", "experimental"]
    },
    "implementations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["language", "framework", "path", "status"],
        "properties": {
          "language": { "type": "string" },
          "framework": { "type": "string" },
          "path": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["repo", "url", "license"],
      "properties": {
        "repo": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "commit": { "type": "string" },
        "license": { "type": "string" }
      }
    },
    "known_limitations": { "type": "array", "items": { "type": "string" } },
    "improvement_opportunities": { "type": "array", "items": { "type": "string" } },
    "algorithm_dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "ids of other library-core algorithms this one conceptually builds on (e.g. a linear solver depending on hadamard-test). Checked by tests/test_repo_structure.py against the actual catalogue, not just documentation."
    },
    "external_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["package", "url", "access"],
        "properties": {
          "package": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "access": { "type": "string", "enum": ["public", "private"] },
          "license": { "type": "string" },
          "note": { "type": "string" }
        }
      },
      "description": "Non-library-core packages the implementation imports at runtime (as opposed to `source`, which describes where this algorithm's own pattern/code came from)."
    },
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "value", "date"],
        "properties": {
          "metric": { "type": "string" },
          "value": { "type": "number" },
          "unit": { "type": "string" },
          "conditions": { "type": "string" },
          "hardware": { "type": "string" },
          "date": { "type": "string", "format": "date" }
        }
      }
    },
    "references": { "type": "array", "items": { "type": "string" } },
    "last_reviewed": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
